{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "CLERK_SECRET_KEY",
        "CLERK_WEBHOOK_SECRET",
        "CONVEX_DEPLOYMENT",
        "GOOGLE_GENERATIVE_AI_API_KEY",
        "MONGODB_URI",
        "AUTH_SECRET",
        "AUTH_GOOGLE_ID",
        "AUTH_GOOGLE_SECRET",
        "AUTH_FACEBOOK_ID",
        "AUTH_FACEBOOK_SECRET",
        "AUTH_TWITTER_ID",
        "AUTH_TWITTER_SECRET",
        "AUTH_GITHUB_ID",
        "AUTH_GITHUB_SECRET",
        "DATABASE_URL",
        "NEXT_PUBLIC_PUSHER_APP_KEY",
        "PUSHER_APP_ID",
        "PUSHER_SECRET",
        "NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME",
        "EXPO_PUBLIC_RAPID_API_KEY",
        "NEXTAUTH_SECRET",
        "ADMIN_USERNAME",
        "ADMIN_PASSWORD",
        "PASSWORD_ELYSANTIUM",
        "USER_ELYSANTIUM",
        "SUPABASE_SERVICE_ROLE_KEY",
        "FIREBASE_PROJECT_ID",
        "FIREBASE_CLIENT_EMAIL",
        "FIREBASE_PRIVATE_KEY",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "LOCATIONIQ_GEOCODE_API_KEY",
        "AUTH_URL"
      ],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "lint:prettier": {},
    "lint:eslint": {
      "dependsOn": ["^build"]
    },
    "format": {
      "dependsOn": ["^build"]
    },
    "format:prettier": {},
    "format:eslint": {
      "dependsOn": ["^build"]
    },
    "type:check": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "start": {
      "dependsOn": ["build"],
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
