{
  "name": "twabblr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "base:prettier": "prettier './**/*.{ts,tsx,html,json,md,css}' --config .prettierrc --cache",
    "base:eslint": "eslint ./ --cache",
    "lint:prettier": "pnpm base:prettier --check",
    "lint:eslint": "pnpm base:eslint",
    "lint": "pnpm lint:prettier && pnpm lint:eslint",
    "format:prettier": "pnpm base:prettier --write",
    "format:eslint": "pnpm base:eslint --fix",
    "format": "pnpm format:prettier && pnpm format:eslint",
    "format-silent": "pnpm format:prettier --loglevel silent && pnpm base:eslint --quiet",
    "type:check": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@headlessui/react": "^2.2.10",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/client": "^6.19.0",
    "@repo/auth": "workspace:*",
    "@repo/react-query": "workspace:*",
    "@repo/ui": "workspace:*",
    "@repo/utils": "workspace:*",
    "@repo/validation": "workspace:*",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "lodash": "^4.18.1",
    "next": "16.4.0",
    "next-cloudinary": "^6.19.3",
    "pusher": "^5.3.4",
    "pusher-js": "^8.6.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "react-hot-toast": "^2.6.1",
    "react-select": "^5.8.0",
    "react-spinners": "^0.17.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcrypt": "^6.0.0",
    "@types/lodash": "^4.17.26",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.4.0",
    "prettier-config-web": "workspace:*",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
