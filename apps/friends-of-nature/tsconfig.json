{
  "extends": "tsconfig/nextjs.json",
  "compilerOptions": {
    "esModuleInterop": true,
    "baseUrl": ".",
    "types": ["node", "react", "react-dom"],
    "paths": {
      "@components/*": ["./components/*"],
      "@features/*": ["./features/*"],
      "@config/*": ["config/*"],
      "@public/*": ["./public/*"],
      "@analytics/*": ["../../packages/analytics/src/*"],
      "@repo/analytics/*": ["../../packages/analytics/src/*"],
      "@repo/utils/*": ["../../packages/utils/src/*"]
    },
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "global.d.ts",
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../desktop-weather/middleware.ts"
  ],
  "exclude": ["node_modules"]
}
