{
  "name": "jobs-react-native",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "dev": "expo start --ios",
    "base:prettier": "prettier './**/*.{ts,tsx,html,json,md,css}' --config .prettierrc --cache",
    "base:eslint": "eslint ./ --cache",
    "lint:prettier": "pnpm base:prettier --check",
    "lint:eslint": "pnpm base:eslint",
    "lint": "pnpm lint:prettier && pnpm lint:eslint",
    "format:prettier": "pnpm base:prettier --write",
    "format:eslint": "pnpm base:eslint --fix",
    "format": "pnpm format:prettier && pnpm format:eslint",
    "format-silent": "pnpm format:prettier --loglevel silent && pnpm format:eslint --quiet",
    "type:check": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/dom-webview": "~57.0.1",
    "@expo/metro-runtime": "~57.0.16",
    "@repo/react-query": "workspace:*",
    "axios": "^1.9.0",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.27.0",
    "@react-native/metro-config": "0.86.3",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "eslint": "^10.12.0",
    "eslint-config-web": "workspace:*",
    "prettier-config-web": "workspace:*",
    "tsconfig": "workspace:*",
    "typescript": "~6.0.3"
  },
  "private": true
}
